# Copy to .env and edit. Everything is optional.

# Starting account value in USD
TEAM_BALANCE=30000

# US tax profile for the estimates on the dashboard
TAX_FILING_STATUS=single      # single | mfj
TAX_OTHER_INCOME=75000        # your other yearly income (sets the bracket)
TAX_STATE=XX                  # two-letter state code, XX = federal only

# Protects the settings API when the dashboard is reachable by others
ADMIN_TOKEN=

# auto = Coinbase live data, falls back to a simulator if unreachable
MARKET_SOURCE=auto
