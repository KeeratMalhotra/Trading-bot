# Copy to .env and edit. Everything is optional.

# Protects Settings / Reset / Pause when the dashboard is reachable by others.
# Leave empty on your own PC. Set it before exposing the URL to viewers.
ADMIN_TOKEN=

# auto = Coinbase live data, falls back to a clearly labelled simulator if unreachable
MARKET_SOURCE=auto

# Demo balance per bot
STARTING_BALANCE=10000

# Coinbase Advanced fee tier to simulate: "auto" or a tier name (Intro 1 ... VIP 4)
FEE_MODE="Advanced 2"

# ---- Future real-money mode: reference only, NOT wired up yet (see README "Going live") ----
# TRADING_MODE=live
# LIVE_TRADING_ACK=I_UNDERSTAND_REAL_MONEY_IS_AT_RISK
# COINBASE_API_KEY_NAME=organizations/.../apiKeys/...
# COINBASE_API_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
# LIVE_MAX_ORDER_USD=50
