# Copy to .env and edit. Everything is optional.

# Starting account value in USD
TEAM_BALANCE=30000

# US tax profile for the estimates on the dashboard
TAX_FILING_STATUS=single      # single | mfj
TAX_OTHER_INCOME=75000        # your other yearly income (sets the bracket)
TAX_STATE=XX                  # two-letter state code, XX = federal only

# Protects the settings API when the dashboard is reachable by others
ADMIN_TOKEN=

# auto / coinbase = live Coinbase prices (keeps retrying, never falls back to fake prices)
# sim = offline simulator, for demos only
MARKET_SOURCE=auto

# Dashboard "what if" line: the same starting amount with this share held in BTC instead.
# Display only (never affects trading). 0 = hide. MIX_REBALANCE: yearly | never
MIX_BTC_SHARE=0.4
MIX_REBALANCE=yearly

# Yield on idle cash (cash not needed as futures margin), e.g. 0.0375.
# 0 = off. Only set it if your real account would earn it (e.g. Coinbase One + idle cash held as USDC).
CASH_APY=0
